{
  "name": "bloblex",
  "private": true,
  "version": "0.1.0-beta.2",
  "workspaces": ["apps/desktop"],
  "scripts": {
    "dev": "npm run dev --workspace @bloblex/desktop",
    "build": "npm run build --workspace @bloblex/desktop",
    "typecheck": "npm run typecheck --workspace @bloblex/desktop",
    "test": "npm run test --workspace @bloblex/desktop",
    "desktop": "npm run tauri --workspace @bloblex/desktop",
    "build:daemon": "cargo build -p bloblex-daemon --bin bloblexd",
    "stage:daemon": "node scripts/stage-daemon.mjs",
    "desktop:dev": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev-windows.ps1",
    "desktop:bundle": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/bundle-windows.ps1"
  }
}
