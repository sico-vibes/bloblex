{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bloblex",
  "version": "0.1.0-beta.5",
  "identifier": "com.bloblex.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Bloblex",
        "width": 1360,
        "height": 860,
        "minWidth": 1000,
        "minHeight": 680,
        "center": true,
        "visible": true,
        "resizable": true,
        "fullscreen": false,
        "titleBarStyle": "Visible"
      }
    ],
    "security": {
      "capabilities": ["default", "main-updates", "main-notifications", "main-links"],
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost blob: data:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:1420 ws://127.0.0.1:1420; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "category": "DeveloperTool",
    "shortDescription": "A local control plane for coding agents",
    "longDescription": "Manage local coding-agent runtimes and sessions from one desktop app.",
    "icon": [
      "../../../assets/icon/bloblex.ico",
      "../../../assets/icon/bloblex-master.png"
    ],
    "resources": [],
    "externalBin": ["binaries/bloblexd", "binaries/bloblex-hook"],
    "targets": ["nsis"],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "nsis": { "installMode": "currentUser" }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDBCMjJGNTc4RkQ3NUEwMEIKUldRTG9IWDllUFVpQzJrYnM4QmU4aWxPbEZuQlVycmNsOW82Vi9tcFNEYTZHU2pkWUs5Mi9lSjkK",
      "endpoints": [
        "https://github.com/sico-vibes/bloblex/releases/latest/download/latest.json"
      ],
      "windows": { "installMode": "passive" }
    }
  }
}
